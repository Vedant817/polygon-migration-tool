# =============================================================================
# Polygon Migration Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# For local development: localhost,127.0.0.1
# For production: your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#
# Then use these settings:
DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# Then use these settings:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# For Azure Redis or other cloud Redis with SSL:
# REDIS_HOST=your-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=True

# -----------------------------------------------------------------------------
# Polygon API Credentials
# -----------------------------------------------------------------------------
#
# Get your API credentials from Polygon:
# 1. Log in to https://polygon.codeforces.com/
# 2. Go to Settings (top-right menu)
# 3. Find "API" section
# 4. Generate new API key
#
POLYGON_API_KEY=your-polygon-api-key
POLYGON_API_SECRET=your-polygon-api-secret

# -----------------------------------------------------------------------------
# Cloud Storage Configuration
# -----------------------------------------------------------------------------
#
# The migration flow depends only on the problems.storage.BlobStorage interface.
# Pick a provider here; its SDK stays behind that interface, so changing this
# value does not require editing the migration flow.
#
#   STORAGE_PROVIDER=azure  -> Azure Blob Storage (azure-storage-blob)
#   STORAGE_PROVIDER=s3     -> any S3-compatible service (Amazon S3, Cloudflare
#                              R2, MinIO) via boto3
#
# STORAGE_CONTAINER_NAME is the Azure container / S3 bucket that receives:
#   test_cases/{problem_id}/{test_number}      input file
#   test_cases/{problem_id}/{test_number}.a    output file
# where {problem_id} is the database Problem.id (not the Polygon ID).

# Which storage provider to use. Options: azure, s3
STORAGE_PROVIDER=s3

# Azure container / S3 bucket name that holds the migrated test cases.
STORAGE_CONTAINER_NAME=testcases

# --- Azure Blob Storage (STORAGE_PROVIDER=azure) ---
# Requires an AAD application plus a user account permitted to use it.
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_USERNAME=your-azure-username
AZURE_PASSWORD=your-azure-password

# --- S3-compatible storage (STORAGE_PROVIDER=s3) ---
# Leave S3_ENDPOINT_URL empty for Amazon S3.
# Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
# MinIO (local):  http://localhost:9000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION_NAME=us-east-1
# "path" works with MinIO and most non-AWS endpoints; "auto" suits AWS.
S3_ADDRESSING_STYLE=path

# -----------------------------------------------------------------------------
# Custom Checker Compilation
# -----------------------------------------------------------------------------
#
# Directory for compiling custom checkers (optional)
# If not set, uses system temp directory
# Requires g++ compiler installed on your system
#
# CUSTOM_CHECKER_DIR=/path/to/checker/directory

# -----------------------------------------------------------------------------
# Quick Start Commands
# -----------------------------------------------------------------------------
#
# 1. Start PostgreSQL and Redis:
#    docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#    docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# 2. Apply migrations:
#    python manage.py migrate
#
# 3. Create superuser:
#    python manage.py createsuperuser
#
# 4. Run server:
#    python manage.py runserver
#
# 5. Access app:
#    http://localhost:8000/
#
# 6. Tests (creates a throwaway test database):
#    python manage.py test
#
